<Window x:Class="UXLabelshop.Views.BatchFillDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="空白单元格批量填充" Height="470" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" FontSize="14"
        InputMethod.IsInputMethodEnabled="False"
        Icon="pack://application:,,,/Assets/app.ico">
    <Border Padding="20">
        <StackPanel>
            <TextBlock Text="填充列"/>
            <ComboBox x:Name="ColumnCombo" Height="28" Margin="0,4,0,12" DisplayMemberPath="Header"/>

            <TextBlock Text="填充方式" Margin="0,0,0,4"/>
            <RadioButton x:Name="ModeFixed" Content="固定值：填充所有空白单元格" IsChecked="True"
                         Margin="0,2" Checked="Mode_Changed"/>
            <RadioButton x:Name="ModeSeq" Content="序列号：前缀 + 起始值，步长递增（补零）"
                         Margin="0,2" Checked="Mode_Changed"/>
            <RadioButton x:Name="ModeCopy" Content="复制上一行同列的非空值"
                         Margin="0,2" Checked="Mode_Changed"/>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="固定值" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="FixedValueBox" Height="26" Margin="0,3"/>

                <TextBlock Grid.Row="1" Text="前缀" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="PrefixBox" Height="26" Margin="0,3"/>

                <TextBlock Grid.Row="2" Text="起始 / 步长" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                    <TextBox x:Name="StartBox" Width="70" Height="26" Text="1"/>
                    <TextBox x:Name="StepBox" Width="70" Height="26" Text="1" Margin="8,0,0,0"/>
                </StackPanel>

                <TextBlock Grid.Row="3" Text="位数(补零)" VerticalAlignment="Center"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="DigitsBox" Height="26" Margin="0,3" Text="3"/>
            </Grid>

            <TextBlock Text="只填充空白单元格，已有值不会被覆盖。" Foreground="Gray"
                       Margin="0,12,0,0" FontSize="12"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="取消" Click="Cancel_Click" Margin="0,0,8,0"/>
                <Button Content="填充" Style="{StaticResource PrimaryButton}" Click="Ok_Click" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
