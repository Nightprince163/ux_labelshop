<Window x:Class="UXLabelshop.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="修改密码" Height="280" Width="380" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" FontSize="14"
        Icon="pack://application:,,,/Assets/app.ico">
    <Border Padding="24">
        <StackPanel>
            <TextBlock Text="为保障账号安全，请设置新密码（≥6 位）" TextWrapping="Wrap" Margin="0,0,0,16" Foreground="Gray"/>

            <TextBlock Text="新密码"/>
            <PasswordBox x:Name="NewPwdBox" Height="30" Margin="0,4,0,12"/>
            <TextBlock Text="确认新密码"/>
            <PasswordBox x:Name="ConfirmPwdBox" Height="30" Margin="0,4,0,16"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="确定" Style="{StaticResource PrimaryButton}" Click="Ok_Click" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
