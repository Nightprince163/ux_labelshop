<UserControl x:Class="UXLabelshop.Views.ScanPrintPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontSize="13"
        InputMethod.IsInputMethodEnabled="False">
    <DockPanel Margin="12">
        <!-- 顶部：模板 / 扫码（元信息行）+ 分组工具栏。样式与模板编辑器共用 App.xaml 的
             ToolButton / DangerToolButton / GroupLabel / ToolSep，图标都是矢量 Geometry。 -->
        <Border DockPanel.Dock="Top" Background="#F8FAFC" Padding="14,10,14,12"
                BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Margin="0,0,0,10">
            <StackPanel>
                <!-- 元信息行：模板选择 + 扫码输入（x:Name 与绑定保持原样，自检依赖） -->
                <DockPanel Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="模板" VerticalAlignment="Center" Foreground="#64748B" Margin="0,0,8,0"/>
                        <ComboBox Height="30" Width="180" VerticalContentAlignment="Center"
                                  ItemsSource="{Binding Templates}"
                                  SelectedItem="{Binding SelectedTemplate}"
                                  DisplayMemberPath="Name"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <TextBlock Text="扫码" VerticalAlignment="Center" Foreground="#64748B" Margin="0,0,8,0"/>
                        <TextBox x:Name="ScanBox" Height="30" Width="234" FontSize="14"
                                 VerticalContentAlignment="Center" Padding="6,0"
                                 InputMethod.IsInputMethodEnabled="False"
                                 Text="{Binding ScanText, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="ScanBox_KeyDown"
                                 ToolTip="扫码枪回车提交；未匹配规则会新增空行供手动填写"/>
                    </StackPanel>
                </DockPanel>

                <WrapPanel Orientation="Horizontal">
                    <!-- 清单 -->
                    <StackPanel Margin="0,0,2,0">
                        <TextBlock Text="清单" Style="{StaticResource GroupLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="新增行" Tag="{StaticResource IcoAddRow}"
                                    Style="{StaticResource ToolButton}"
                                    ToolTip="在清单末尾新增一张空白标签"
                                    Command="{Binding AddBlankRowCommand}"/>
                            <Button Content="删行" Tag="{StaticResource IcoRemoveRow}"
                                    Style="{StaticResource DangerToolButton}"
                                    ToolTip="删除当前选中行" Click="DeleteRow_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <Rectangle Style="{StaticResource ToolSep}"/>

                    <!-- 编辑 -->
                    <StackPanel Margin="0,0,2,0">
                        <TextBlock Text="编辑" Style="{StaticResource GroupLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="填充…" Tag="{StaticResource IcoFill}"
                                    Style="{StaticResource ToolButton}"
                                    ToolTip="固定值 / 序列号 / 复制上一行 填充空白单元格"
                                    Click="BatchFill_Click"/>
                            <Button Content="清空" Tag="{StaticResource IcoDelete}"
                                    Style="{StaticResource DangerToolButton}"
                                    ToolTip="清空全部清单行" Click="ClearButton_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <Rectangle Style="{StaticResource ToolSep}"/>

                    <!-- 视图 -->
                    <StackPanel Margin="0,0,2,0">
                        <TextBlock Text="视图" Style="{StaticResource GroupLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="PreviewToggleButton" Content="隐藏预览"
                                    Tag="{StaticResource IcoEye}" Style="{StaticResource ToolButton}"
                                    ToolTip="隐藏 / 显示右侧标签预览（分隔条也可拖动调整宽度）"
                                    Click="TogglePreview_Click"/>
                        </StackPanel>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 底部：状态栏 -->
        <Border DockPanel.Dock="Bottom" Background="#F5F7FA" Padding="10,6" CornerRadius="4" Margin="0,10,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="Gray">
                    <Run Text="共 "/><Run Text="{Binding RowCount, Mode=OneWay}"/><Run Text=" 张（每行 = 1 张标签）"/>
                </TextBlock>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#2B579A" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="#2B579A"
                               TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                    <TextBlock Text="Ctrl+点击列标题：向下填充空白格" Margin="18,0,0,0"
                               VerticalAlignment="Center" Foreground="Gray" FontSize="12"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 中部：清单 + 预览（可拖拽分栏、可隐藏） -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360"/>
                <ColumnDefinition x:Name="PreviewSplitterCol" Width="6"/>
                <ColumnDefinition x:Name="PreviewColumn" Width="360" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="DataGridRows" Grid.Column="0"
                      InputMethod.IsInputMethodEnabled="False"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserSortColumns="False"
                      HeadersVisibility="Column" GridLinesVisibility="All"
                      AlternatingRowBackground="#F7F9FC" Background="White"
                      SelectionMode="Single" SelectionChanged="DataGridRows_SelectionChanged"/>

            <GridSplitter x:Name="PreviewSplitter" Grid.Column="1" Width="6"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="#E0E0E0" Cursor="SizeWE"/>

            <Border x:Name="PreviewPanel" Grid.Column="2" BorderBrush="#DDD" BorderThickness="1,0,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#FAFAFA" Padding="8,6" BorderBrush="#EEE" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="标签预览" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding PreviewInfo}" Foreground="Gray" FontSize="11"
                                       Margin="12,0,0,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="200"
                                       ToolTip="{Binding PreviewInfo}"/>
                        </StackPanel>
                    </Border>
                    <Button DockPanel.Dock="Bottom" Content="去打印…" Height="40" Margin="8"
                            Style="{StaticResource PrimaryButton}" Click="Print_Click"/>
                    <Border Background="#FAFAFA">
                        <!-- 横向不滚动：让图像按面板宽度等比缩放，整张标签一次性可见；
                             超高的标签纵向滚动 -->
                        <ScrollViewer x:Name="PreviewScroll" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <Image Source="{Binding PreviewImage}" Stretch="Uniform"
                                   HorizontalAlignment="Center" Margin="10"
                                   ToolTip="预览按面板宽度等比缩放；拖动左侧分隔条可放大查看细节"/>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
