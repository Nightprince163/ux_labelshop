<Window x:Class="UXLabelshop.Views.DatabaseSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="数据库与本机设置" Height="470" Width="420" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" FontSize="14"
        Icon="pack://application:,,,/Assets/app.ico">
    <Border Padding="24">
        <StackPanel>
            <TextBlock Text="MySQL 服务器连接信息（保存到本机，密码经 DPAPI 加密）"
                       TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,16"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="服务器地址" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="HostBox" Height="28" Margin="0,4,0,10"/>

                <TextBlock Grid.Row="1" Text="端口" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="PortBox" Height="28" Margin="0,4,0,10"/>

                <TextBlock Grid.Row="2" Text="数据库名" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="DbBox" Height="28" Margin="0,4,0,10"/>

                <TextBlock Grid.Row="3" Text="用户名" VerticalAlignment="Center"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="UserBox" Height="28" Margin="0,4,0,10"/>

                <TextBlock Grid.Row="4" Text="密码" VerticalAlignment="Center"/>
                <PasswordBox Grid.Row="4" Grid.Column="1" x:Name="PwdBox" Height="28" Margin="0,4,0,10"/>
            </Grid>

            <TextBlock Text="客户端升级地址（可选）" Margin="0,14,0,4" Foreground="#64748B"/>
            <TextBox x:Name="UpdateUrlBox" Height="28"
                     ToolTip="nginx 发布目录的访问地址，留空则不检查更新"/>
            <TextBlock Text="例如 http://192.168.1.35/client-update/ ；留空则不检查更新"
                       FontSize="11" Foreground="Gray" Margin="0,4,0,0" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="测试连接" Click="Test_Click"/>
                <Button Content="保存" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Save_Click"/>
            </StackPanel>
            <TextBlock x:Name="ResultText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="Gray"/>
        </StackPanel>
    </Border>
</Window>
