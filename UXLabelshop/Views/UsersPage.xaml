<UserControl x:Class="UXLabelshop.Views.UsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontSize="14">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="新增用户" Style="{StaticResource PrimaryButton}" Click="AddUserButton_Click"/>
            <Button Content="保存修改" Margin="8,0,0,0" Command="{Binding SaveCommand}"/>
            <Button Content="刷新" Margin="8,0,0,0" Command="{Binding LoadCommand}"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="Gray" Margin="16,4,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <DataGrid ItemsSource="{Binding Users}" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Single" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" Background="White"
                  AlternatingRowBackground="#F7F9FC">
            <DataGrid.Columns>
                <DataGridTextColumn Header="工号" Binding="{Binding Username}" IsReadOnly="True" Width="140"/>
                <DataGridTextColumn Header="姓名" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
                <DataGridTemplateColumn Header="角色" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox SelectedValue="{Binding Role, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Tag" Tag="user">
                                <ComboBoxItem Content="用户" Tag="user"/>
                                <ComboBoxItem Content="管理员" Tag="admin"/>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                <DataGridTextColumn Header="最近登录" Binding="{Binding LastLoginAt, StringFormat=yyyy-MM-dd HH:mm}" IsReadOnly="True" Width="170"/>
                <DataGridTemplateColumn Header="操作" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="重置密码" Command="{Binding DataContext.ResetPasswordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
