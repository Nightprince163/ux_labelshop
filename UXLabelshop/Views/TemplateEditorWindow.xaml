<Window x:Class="UXLabelshop.Views.TemplateEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="模板编辑器" Height="800" Width="1240" MinHeight="640" MinWidth="1080"
        WindowStartupLocation="CenterOwner" FontSize="13"
        Icon="pack://application:,,,/Assets/app.ico">

    <DockPanel>
        <!-- 工具栏：分区（添加 / 层级 / 操作），组间竖线分隔，按钮带矢量图标 -->
        <Border DockPanel.Dock="Top" Background="#F8FAFC" Padding="14,10,14,12"
                BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <StackPanel>
                <!-- 元信息行：模板名称 + 缩放 -->
                <DockPanel Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="模板名称" VerticalAlignment="Center" Foreground="#64748B" Margin="0,0,8,0"/>
                        <TextBox x:Name="NameBox" Width="210" Height="28" VerticalContentAlignment="Center"
                                 Padding="6,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <TextBlock Text="缩放" VerticalAlignment="Center" Foreground="#64748B" Margin="0,0,8,0"/>
                        <Slider x:Name="ZoomSlider" Width="150" Minimum="0.4" Maximum="1.6" Value="1"
                                VerticalAlignment="Center" ValueChanged="Zoom_Changed"/>
                        <TextBlock Text="{Binding Value, ElementName=ZoomSlider, StringFormat={}{0:P0}}"
                                   Width="42" TextAlignment="Right" VerticalAlignment="Center"
                                   Foreground="#64748B" Margin="8,0,0,0"/>
                    </StackPanel>
                </DockPanel>

                <WrapPanel Orientation="Horizontal">
                    <!-- 添加 -->
                    <StackPanel Margin="0,0,2,0">
                        <TextBlock Text="添加" Style="{StaticResource GroupLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="文本" Tag="{StaticResource IcoText}" Style="{StaticResource ToolButton}"
                                    ToolTip="添加文本（可写 {{变量}}）" Click="AddText_Click"/>
                            <Button Content="条码" Tag="{StaticResource IcoBarcode}" Style="{StaticResource ToolButton}"
                                    ToolTip="添加 Code128 一维码" Click="AddBarcode_Click"/>
                            <Button Content="二维码" Tag="{StaticResource IcoQr}" Style="{StaticResource ToolButton}"
                                    ToolTip="添加二维码" Click="AddQr_Click"/>
                            <Button Content="矩形" Tag="{StaticResource IcoRect}" Style="{StaticResource ToolButton}"
                                    ToolTip="添加边框矩形" Click="AddRect_Click"/>
                            <Button Content="线条" Tag="{StaticResource IcoLine}" Style="{StaticResource ToolButton}"
                                    ToolTip="添加直线" Click="AddLine_Click"/>
                            <Button Content="图片" Tag="{StaticResource IcoImage}" Style="{StaticResource ToolButton}"
                                    ToolTip="添加位图（Logo），依赖外部图片文件" Click="AddImage_Click"/>
                            <Button Content="Pb 标志" Tag="{StaticResource IcoPb}" Style="{StaticResource ToolButton}"
                                    ToolTip="插入内置矢量 Pb 无铅标志（不依赖图片文件，任何分辨率都清晰）"
                                    Click="AddPbMark_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <Rectangle Style="{StaticResource ToolSep}"/>

                    <!-- 层级 -->
                    <StackPanel Margin="0,0,2,0">
                        <TextBlock Text="层级" Style="{StaticResource GroupLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="上移一层" Tag="{StaticResource IcoUp}" Style="{StaticResource ToolButton}"
                                    ToolTip="把选中元素上移一层" Click="Front_Click"/>
                            <Button Content="下移一层" Tag="{StaticResource IcoDown}" Style="{StaticResource ToolButton}"
                                    ToolTip="把选中元素下移一层" Click="Back_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <Rectangle Style="{StaticResource ToolSep}"/>

                    <!-- 操作 -->
                    <StackPanel Margin="0,0,2,0">
                        <TextBlock Text="操作" Style="{StaticResource GroupLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="UndoButton" Content="撤销" Tag="{StaticResource IcoUndo}"
                                    Style="{StaticResource ToolButton}" IsEnabled="False"
                                    ToolTip="撤销上一步（Ctrl+Z）" Click="Undo_Click"/>
                            <Button x:Name="RedoButton" Content="重做" Tag="{StaticResource IcoRedo}"
                                    Style="{StaticResource ToolButton}" IsEnabled="False"
                                    ToolTip="重做（Ctrl+Y）" Click="Redo_Click"/>
                            <Button Content="全选" Style="{StaticResource ToolButton}"
                                    Margin="12,0,0,0" ToolTip="选中全部元素（Ctrl+A）" Click="SelectAll_Click"/>
                            <Button Content="删除" Tag="{StaticResource IcoDelete}" Style="{StaticResource ToolButton}"
                                    Margin="0,0,4,0" ToolTip="删除选中元素" Click="DeleteElement_Click"/>
                            <Button Content="保存" Tag="{StaticResource IcoSave}"
                                    Style="{StaticResource PrimaryToolButton}" Margin="12,0,4,0"
                                    ToolTip="保存为新版本" Click="Save_Click"/>
                            <Button Content="试打" Tag="{StaticResource IcoPrint}" Style="{StaticResource ToolButton}"
                                    ToolTip="用当前样例数据预览打印" Click="TestPrint_Click"/>
                            <Button Content="发布" Tag="{StaticResource IcoPublish}"
                                    Style="{StaticResource PrimaryToolButton}"
                                    ToolTip="保存并发布为可用模板" Click="Publish_Click"/>
                        </StackPanel>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 状态栏 -->
        <Border DockPanel.Dock="Bottom" Background="#F5F7FA" Padding="10,6" BorderBrush="#DDD" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" Foreground="#2B579A"/>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="290"/>
            </Grid.ColumnDefinitions>

            <!-- 画布 -->
            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Background="#E9ECF1">
                <Border Margin="20" Background="White" BorderBrush="#BBB" BorderThickness="1"
                        HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Canvas x:Name="EditorCanvas" Background="White"
                            MouseLeftButtonDown="Canvas_MouseDown"
                            MouseMove="Canvas_MouseMove"
                            MouseLeftButtonUp="Canvas_MouseUp">
                        <Canvas.LayoutTransform>
                            <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1"/>
                        </Canvas.LayoutTransform>
                        <Image x:Name="PreviewImage" Stretch="Fill" IsHitTestVisible="False"/>
                        <Canvas x:Name="OverlayLayer" Background="Transparent"/>
                        <Rectangle x:Name="RubberBand" Visibility="Collapsed" IsHitTestVisible="False"
                                   Fill="#333B82F6" Stroke="#3B82F6" StrokeThickness="1"
                                   StrokeDashArray="4,3"/>
                    </Canvas>
                </Border>
            </ScrollViewer>

            <!-- 属性面板 -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Border Background="#FAFBFC" BorderBrush="#DDD" BorderThickness="1,0,0,0" Padding="12">
                    <StackPanel>
                        <TextBlock Text="元素属性" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock x:Name="TypeText" Foreground="Gray" Margin="0,2,0,8"/>
                        <TextBlock x:Name="SelectionHint" Foreground="#2B579A" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="X (mm)"/>
                                <TextBox x:Name="XBox" Height="24" LostFocus="Panel_LostFocus" KeyDown="Panel_EnterKey"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Y (mm)"/>
                                <TextBox x:Name="YBox" Height="24" LostFocus="Panel_LostFocus" KeyDown="Panel_EnterKey"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Text="宽 (mm)"/>
                                <TextBox x:Name="WBox" Height="24" LostFocus="Panel_LostFocus" KeyDown="Panel_EnterKey"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Text="高 (mm)"/>
                                <TextBox x:Name="HBox" Height="24" LostFocus="Panel_LostFocus" KeyDown="Panel_EnterKey"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="字体" Margin="0,10,0,2"/>
                        <ComboBox x:Name="FontCombo" Height="24" IsEditable="True"
                                  LostFocus="Panel_LostFocus" KeyDown="Panel_EnterKey"
                                  SelectionChanged="Panel_Changed">
                            <ComboBoxItem Content="微软雅黑"/>
                            <ComboBoxItem Content="宋体"/>
                            <ComboBoxItem Content="黑体"/>
                            <ComboBoxItem Content="Arial"/>
                            <ComboBoxItem Content="Consolas"/>
                        </ComboBox>

                        <!-- 文字样式：字号（纯数字，类似 Excel）+ 图标开关 -->
                        <TextBlock Text="文字样式" Style="{StaticResource FieldLabel}" Margin="0,10,0,2"/>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="FontSizeCombo" Width="74" Height="30" IsEditable="True"
                                      VerticalContentAlignment="Center" Padding="5,0"
                                      ToolTip="字号（磅）：数字越大字越大，可直接输入任意数值"
                                      LostFocus="Panel_LostFocus" KeyDown="Panel_EnterKey"
                                      SelectionChanged="Panel_Changed">
                                <ComboBoxItem Content="6"/>
                                <ComboBoxItem Content="8"/>
                                <ComboBoxItem Content="9"/>
                                <ComboBoxItem Content="10"/>
                                <ComboBoxItem Content="11"/>
                                <ComboBoxItem Content="12"/>
                                <ComboBoxItem Content="14"/>
                                <ComboBoxItem Content="16"/>
                                <ComboBoxItem Content="18"/>
                                <ComboBoxItem Content="20"/>
                                <ComboBoxItem Content="24"/>
                                <ComboBoxItem Content="28"/>
                                <ComboBoxItem Content="36"/>
                            </ComboBox>
                            <Rectangle Width="1" Height="20" Fill="#C3CEDD" Margin="7,0,7,0"
                                       VerticalAlignment="Center"/>
                            <ToggleButton x:Name="BoldToggle" Tag="{StaticResource IcoBold}"
                                          Style="{StaticResource IconToggle}" ToolTip="粗体"
                                          Checked="Panel_Changed" Unchecked="Panel_Changed"/>
                            <ToggleButton x:Name="ItalicToggle" Tag="{StaticResource IcoItalic}"
                                          Style="{StaticResource IconToggle}" ToolTip="斜体"
                                          Checked="Panel_Changed" Unchecked="Panel_Changed"/>
                            <ToggleButton x:Name="WrapToggle"
                                          Style="{StaticResource IconToggleWrap}"
                                          ToolTip="自动换行：文字超出元素宽度时折行显示"
                                          Checked="Panel_Changed" Unchecked="Panel_Changed"/>
                        </StackPanel>

                        <!-- 对齐：6 个图标单选排同一排（前 3 水平 / 后 3 垂直），选中项带圆角边框 -->
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <RadioButton x:Name="AlignLeft" GroupName="HAlign" IsChecked="True"
                                         Tag="{StaticResource IcoAlignLeft}" Style="{StaticResource IconRadio}"
                                         ToolTip="左对齐" Checked="Panel_Changed"/>
                            <RadioButton x:Name="AlignCenter" GroupName="HAlign"
                                         Tag="{StaticResource IcoAlignCenter}" Style="{StaticResource IconRadio}"
                                         ToolTip="水平居中" Checked="Panel_Changed"/>
                            <RadioButton x:Name="AlignRight" GroupName="HAlign"
                                         Tag="{StaticResource IcoAlignRight}" Style="{StaticResource IconRadio}"
                                         ToolTip="右对齐" Checked="Panel_Changed"/>
                            <Rectangle Width="1" Height="20" Fill="#C3CEDD" Margin="4,0,7,0"
                                       VerticalAlignment="Center"/>
                            <RadioButton x:Name="ValignTop" GroupName="VAlign"
                                         Tag="{StaticResource IcoVAlignTop}" Style="{StaticResource IconRadio}"
                                         ToolTip="顶部对齐" Checked="Panel_Changed"/>
                            <RadioButton x:Name="ValignMiddle" GroupName="VAlign" IsChecked="True"
                                         Tag="{StaticResource IcoVAlignMiddle}" Style="{StaticResource IconRadio}"
                                         ToolTip="垂直居中" Checked="Panel_Changed"/>
                            <RadioButton x:Name="ValignBottom" GroupName="VAlign"
                                         Tag="{StaticResource IcoVAlignBottom}" Style="{StaticResource IconRadio}"
                                         ToolTip="底部对齐" Checked="Panel_Changed"/>
                        </StackPanel>

                        <!-- 内容输入框放在文字/对齐选项下方，紧挨变量列表，方便双击变量插入 -->
                        <TextBlock Text="内容（支持 {{变量}}）" Margin="0,12,0,2"/>
                        <TextBox x:Name="ContentBox" Height="70" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 LostFocus="Panel_LostFocus"/>

                        <TextBlock Text="变量（双击插入到内容）" FontWeight="SemiBold" Margin="0,10,0,0"/>
                        <ListBox x:Name="VarList" Height="150" Margin="0,4,0,0" DisplayMemberPath="Display"
                                 MouseDoubleClick="VarList_DoubleClick"/>
                        <Button Content="变量管理…（增删改 / 缺省值 / 公式）" Margin="0,6,0,0"
                                Click="AddVar_Click" ToolTip="打开独立变量管理窗口，变量定义存于 label_template_var 子表"/>

                        <TextBlock Text="画布说明：拖动元素移动，拖右下角小方块缩放；坐标单位毫米。"
                                   Foreground="Gray" TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
