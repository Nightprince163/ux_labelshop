<Window x:Class="UXLabelshop.Views.AddUserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新增用户" Height="340" Width="360" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" FontSize="14"
        Icon="pack://application:,,,/Assets/app.ico">
    <Border Padding="24">
        <StackPanel>
            <TextBlock Text="工号"/>
            <TextBox x:Name="UserNameBox" Height="28" Margin="0,4,0,10"/>
            <TextBlock Text="姓名"/>
            <TextBox x:Name="NameBox" Height="28" Margin="0,4,0,10"/>
            <TextBlock Text="角色"/>
            <ComboBox x:Name="RoleCombo" Height="28" Margin="0,4,0,10" SelectedIndex="0">
                <ComboBoxItem Content="用户" Tag="user"/>
                <ComboBoxItem Content="管理员" Tag="admin"/>
            </ComboBox>
            <TextBlock Text="初始密码（用户首次登录须改密）"/>
            <TextBox x:Name="PwdBox" Height="28" Margin="0,4,0,10" Text="123456"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="取消" Click="Cancel_Click" Margin="0,0,8,0"/>
                <Button Content="确定" Style="{StaticResource PrimaryButton}" Click="Ok_Click" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
