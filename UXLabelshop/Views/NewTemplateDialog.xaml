<Window x:Class="UXLabelshop.Views.NewTemplateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建模板" Width="420" Height="610" MinHeight="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" FontSize="14"
        Icon="pack://application:,,,/Assets/app.ico">
    <!-- 按钮固定在 DockPanel 底部；内容区放 ScrollViewer，避免内容变多时把按钮挤出可视区 -->
    <DockPanel Margin="22">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="取消" Click="Cancel_Click" Margin="0,0,8,0"/>
            <Button Content="创建" Style="{StaticResource PrimaryButton}" Click="Ok_Click" IsDefault="True"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="模板编码（英文/下划线）"/>
                <TextBox x:Name="CodeBox" Height="28" Margin="0,4,0,10"/>

                <TextBlock Text="模板名称"/>
                <TextBox x:Name="NameBox" Height="28" Margin="0,4,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="宽度 (mm)"/>
                        <TextBox x:Name="WidthBox" Height="28" Margin="0,4,0,10" Text="100"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="高度 (mm)"/>
                        <TextBox x:Name="HeightBox" Height="28" Margin="0,4,0,10" Text="50"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="分辨率 (dpi)"/>
                <ComboBox x:Name="DpiCombo" Height="28" Margin="0,4,0,10" SelectedIndex="0">
                    <ComboBoxItem Content="203"/>
                    <ComboBoxItem Content="300"/>
                </ComboBox>

                <TextBlock Text="备注（可选）"/>
                <TextBox x:Name="RemarkBox" Height="28" Margin="0,4,0,10"/>

                <!-- 从 .lsd 导入 -->
                <Border Background="#F1F6FC" BorderBrush="#C9DCF2" BorderThickness="1"
                        CornerRadius="5" Padding="10" Margin="0,2,0,10">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="从 lsd 导入…" Click="ImportLsd_Click"
                                    Padding="10,3" MinWidth="0" Margin="8,0,0,0"/>
                            <TextBlock Text="从 LabelShop .lsd 文件导入" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock x:Name="ImportInfo" Text="导入后自动带出名称、幅面与变量/元素；模板编码仍需手动填写。"
                                   Foreground="#64748B" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="创建后会自动生成一条扫码规则（默认禁用），请在「扫码规则」中校准。"
                           Foreground="Gray" TextWrapping="Wrap" FontSize="12"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
