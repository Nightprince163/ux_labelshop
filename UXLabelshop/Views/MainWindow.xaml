<Window x:Class="UXLabelshop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UX_LabelShop" Height="760" Width="1180" MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen" WindowState="Maximized" FontSize="14"
        Icon="pack://application:,,,/Assets/app.ico">
    <DockPanel>
        <!-- 顶栏 -->
        <Border DockPanel.Dock="Top" Background="{StaticResource AccentBrush}" Padding="20,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock Text="{Binding Welcome}" Foreground="White" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="检查更新" Foreground="White" Background="Transparent" BorderThickness="0"
                            Padding="8,2" Margin="0,0,12,0" Click="UpdateCheck_Click"
                            ToolTip="检查服务器上有没有新版本客户端"/>
                    <Button x:Name="LogoutButton" Content="退出登录" Foreground="White" Background="Transparent"
                            BorderThickness="0" Click="LogoutButton_Click" Padding="8,2"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/ux-logo-x.png"
                           Width="24" Height="26" Stretch="Uniform" Margin="0,0,10,0"
                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                           ToolTip="优迅"/>
                    <TextBlock Text="UX_LabelShop" Foreground="White" FontSize="18"
                               FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 升级提示条：默认隐藏，只在启动时发现新版本才显示（不强制、不自动下载） -->
        <Border x:Name="UpdateBanner" DockPanel.Dock="Top" Visibility="Collapsed"
                Background="#FFF8E1" BorderBrush="#EAD4A0" BorderThickness="0,0,0,1" Padding="14,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="12,0,0,0">
                    <Button x:Name="UpdateNowButton" Content="立即更新" Padding="10,4"
                            Click="UpdateNow_Click" ToolTip="下载新版本并重启生效"/>
                    <Button Content="稍后" Margin="8,0,0,0" Padding="10,4" Click="UpdateLater_Click"/>
                </StackPanel>
                <TextBlock x:Name="UpdateBannerText" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航 -->
            <Border Grid.Column="0" Background="{StaticResource NavBrush}" BorderBrush="#DDD" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,12,0,0">
                    <ItemsControl ItemsSource="{Binding NavItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource NavButton}" Width="180"
                                        Command="{Binding DataContext.NavCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Key}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="Transparent" Padding="16,10">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#E4E9F0"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#D6E0F0"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <TextBlock Text="{Binding Title}"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 内容区 -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="0"/>
        </Grid>
    </DockPanel>
</Window>
