<Window x:Class="UXLabelshop.Views.ScanRuleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="扫码规则" Height="700" Width="880"
        WindowStartupLocation="CenterOwner" FontSize="13"
        Icon="pack://application:,,,/Assets/app.ico">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,12,0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="新增规则" Click="Add_Click"/>
                <Button Content="删除" Margin="8,0,0,0" Click="Delete_Click"/>
            </StackPanel>
            <ListBox x:Name="RuleList" DisplayMemberPath="Name" SelectionChanged="RuleList_SelectionChanged"/>
        </DockPanel>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="规则名称"/>
                <TextBox x:Name="NameBox" Height="26" Margin="0,4,0,8"/>

                <TextBlock Text="规则类型"/>
                <ComboBox x:Name="KindCombo" Height="26" Margin="0,4,0,8" SelectionChanged="Kind_Changed">
                    <ComboBoxItem Content="分隔符切段（delimited）" Tag="delimited"/>
                    <ComboBoxItem Content="正则表达式（regex）" Tag="regex"/>
                </ComboBox>

                <StackPanel x:Name="DelimitedPanel">
                    <TextBlock Text="分隔符"/>
                    <TextBox x:Name="DelimiterBox" Height="26" Margin="0,4,0,8"
                             TextChanged="SampleOrDelimiter_Changed"/>

                    <TextBlock Text="首段类型标记（可空，如 A/B/C）"/>
                    <TextBox x:Name="MarkerBox" Height="26" Margin="0,4,0,8"
                             TextChanged="SampleOrDelimiter_Changed"/>

                    <TextBlock Text="段号 → 变量映射（按测试样例自动拆分，变量请手动选择）"/>
                    <DataGrid x:Name="SeqGrid" Height="180" Margin="0,4,0,4"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserSortColumns="False" CanUserReorderColumns="False" CanUserResizeRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="All" RowHeight="30"
                              SelectionMode="Single" SelectionUnit="Cell" FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="段号" Binding="{Binding Seq}" IsReadOnly="True" Width="56">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="测试内容" Binding="{Binding Display}" IsReadOnly="True" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding Content}"/>
                                        <Setter Property="Padding" Value="4,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="对应变量" Width="230">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Height="24" Margin="2" VerticalAlignment="Center"
                                                  ItemsSource="{Binding DataContext.VarOptions,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                  DisplayMemberPath="Label" SelectedValuePath="Key"
                                                  SelectedValue="{Binding Key, Mode=TwoWay,
                                                      UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="SeqHint" Foreground="Gray" FontSize="11" TextWrapping="Wrap"
                               Margin="0,0,0,8"/>
                </StackPanel>

                <StackPanel x:Name="RegexPanel" Visibility="Collapsed">
                    <TextBlock Text="正则（命名捕获组，如 ^(?&lt;order&gt;WX-\d{6}-\d{2})$）"/>
                    <TextBox x:Name="PatternBox" Height="60" Margin="0,4,0,8" AcceptsReturn="True"
                             FontFamily="Consolas" TextWrapping="Wrap"/>

                    <TextBlock Text="捕获组 → 变量映射（每行：组名=变量key）"/>
                    <TextBox x:Name="MappingBox" Height="80" Margin="0,4,0,8" AcceptsReturn="True"
                             FontFamily="Consolas" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="优先级（小值优先）"/>
                        <TextBox x:Name="PriorityBox" Height="26" Margin="0,4,0,0" Text="50"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                        <CheckBox x:Name="EnabledCheck" Content="启用该规则" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="测试样例扫码内容"/>
                <TextBox x:Name="SampleBox" Height="26" Margin="0,4,0,8"
                         TextChanged="SampleOrDelimiter_Changed"/>

                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Content="测试匹配" Click="Test_Click"/>
                    <TextBlock x:Name="TestResult" VerticalAlignment="Center" Margin="12,0,0,0"
                               TextWrapping="Wrap" Foreground="#2B579A" MaxWidth="420"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,10">
                    <Button Content="保存规则" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
                    <Button Content="关闭" Margin="8,0,0,0" Click="Close_Click" IsCancel="True"/>
                </StackPanel>

                <TextBlock Text="说明：分隔符切段模式会先去首尾空段，若设置了标记则首段必须等于标记并被移除，随后按段号取值。段号表随样例与分隔符自动重排，已选变量按段号保留。"
                           Foreground="Gray" TextWrapping="Wrap" FontSize="11"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
