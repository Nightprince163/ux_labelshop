<Window x:Class="UXLabelshop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UX_LabelShop 登录" Height="406" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        FontSize="14"
        Icon="pack://application:,,,/Assets/app.ico">
    <Border Padding="32">
        <StackPanel>
            <TextBlock Text="UX_LabelShop" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4"/>
            <TextBlock Text="标签打印系统 · 桌面客户端" Foreground="Gray" Margin="0,0,0,24"/>

            <TextBlock Text="工号"/>
            <TextBox x:Name="UserNameBox" Height="30" Margin="0,4,0,12"
                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="密码"/>
            <PasswordBox x:Name="PwdBox" Height="30" Margin="0,4,0,8"
                         KeyDown="PwdBox_KeyDown"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <CheckBox Content="记住工号" IsChecked="{Binding RememberUsername}" VerticalAlignment="Center"/>
                <CheckBox x:Name="RememberPasswordBox" Content="记住密码" IsChecked="{Binding RememberPassword}" VerticalAlignment="Center"
                          Margin="16,0,0,0" ToolTip="密码经 Windows DPAPI 加密后保存在本机 config.json"/>
                <Button x:Name="DbSettingButton" Content="数据库 / 本机设置" Margin="16,0,0,0"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource AccentBrush}" Click="DbSettingButton_Click"/>
            </StackPanel>

            <Button x:Name="LoginButton" Content="登 录" Height="36" Style="{StaticResource PrimaryButton}"
                    Click="LoginButton_Click" IsDefault="True"/>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="#C0392B" Margin="0,12,0,0"
                       TextWrapping="Wrap" MinHeight="40" FontSize="13"/>
        </StackPanel>
    </Border>
</Window>
