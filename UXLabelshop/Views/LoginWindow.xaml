<Window x:Class="UXLabelshop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UX_LabelShop 登录" Height="620" Width="1000"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif" FontSize="14"
        Icon="pack://application:,,,/Assets/app.ico">

    <Window.Resources>
        <SolidColorBrush x:Key="BrandCyan" Color="#3FE3F5"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#EAF6FF"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8AA6BF"/>
        <SolidColorBrush x:Key="PanelBase" Color="#070D18"/>

        <LinearGradientBrush x:Key="LoginBtnBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1198B8" Offset="0"/>
            <GradientStop Color="#2ED8E8" Offset="0.55"/>
            <GradientStop Color="#54F0DC" Offset="1"/>
        </LinearGradientBrush>

        <!-- 输入框外壳：聚焦时青色描边 + 发光 -->
        <Style x:Key="FieldShell" TargetType="Border">
            <Setter Property="Height" Value="44"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="#122238"/>
            <Setter Property="BorderBrush" Value="#2A4761"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,0"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource BrandCyan}"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#3FE3F5" BlurRadius="11" ShadowDepth="0" Opacity="0.45"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldInput" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{StaticResource BrandCyan}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="FieldPassword" TargetType="PasswordBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{StaticResource BrandCyan}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- 深色复选框 -->
        <Style x:Key="DarkCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="15" Height="15" CornerRadius="3"
                                    Background="#122238" BorderBrush="#3A5C77" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="Tick" Data="M2,7 L5.5,10.5 L12,3" Stroke="#05212B"
                                      StrokeThickness="2.2" Stretch="Uniform" Margin="2.5"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource BrandCyan}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BrandCyan}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BrandCyan}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 右上角窗口按钮 -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#9DB8CE"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E3C52"/>
                                <Setter Property="Foreground" Value="{StaticResource BrandCyan}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#6A2230"/>
                                <Setter Property="Foreground" Value="#FFD9DE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource BrandCyan}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Foreground" Value="#03232C"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="9" Background="{StaticResource LoginBtnBrush}">
                            <Border.Effect>
                                <DropShadowEffect Color="#2ED8E8" BlurRadius="18" ShadowDepth="0" Opacity="0.38"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.74"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 扫描线动画在 code-behind 的 Loaded 里启动（避免 Storyboard TargetName 解析异常） -->

    <Border CornerRadius="14" Background="{StaticResource PanelBase}"
            BorderBrush="#1D3A52" BorderThickness="1">
        <Grid x:Name="RootGrid" ClipToBounds="True"
              MouseLeftButtonDown="Root_MouseLeftButtonDown">
            <Grid.Clip>
                <RectangleGeometry Rect="0,0,1000,620" RadiusX="14" RadiusY="14"/>
            </Grid.Clip>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="600"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= 左：芯片二维码背景 ================= -->
            <Grid Grid.Column="0" ClipToBounds="True">
                <Image Source="pack://application:,,,/Assets/login-bg.jpg"
                       Stretch="UniformToFill" HorizontalAlignment="Center"
                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>

                <!-- 整体压暗 + 右侧淡出到纯色，和右栏自然衔接 -->
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#99050B14" Offset="0"/>
                            <GradientStop Color="#66050B14" Offset="0.5"/>
                            <GradientStop Color="#F0070D18" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                            <GradientStop Color="#B0050B14" Offset="0"/>
                            <GradientStop Color="#00050B14" Offset="0.55"/>
                            <GradientStop Color="#66050B14" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- 扫描线 -->
                <Rectangle x:Name="ScanLine" Height="2" VerticalAlignment="Top"
                           Opacity="0" IsHitTestVisible="False" Margin="0,0,0,0">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="#7FF3FF" Offset="0.5"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                    <Rectangle.RenderTransform>
                        <TranslateTransform Y="0"/>
                    </Rectangle.RenderTransform>
                </Rectangle>

                <!-- 品牌 -->
                <StackPanel Margin="44,42,0,0" VerticalAlignment="Top" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Assets/ux-logo-x.png"
                               Width="38" Height="42" Stretch="Uniform"
                               VerticalAlignment="Center" Margin="0,0,14,0"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               ToolTip="优迅"/>
                        <TextBlock Text="UX_LabelShop" FontSize="27" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="L A B E L   P R I N T I N G   S Y S T E M" FontSize="10.5"
                               Foreground="{StaticResource BrandCyan}" Margin="0,10,0,0"/>
                    <Rectangle Height="2" Width="58" Fill="{StaticResource BrandCyan}"
                               HorizontalAlignment="Left" Margin="0,20,0,0" RadiusX="1" RadiusY="1"/>
                    <TextBlock Text="智能标签设计 · 扫码打印 · 数据追溯" FontSize="13"
                               Foreground="#B9D4E6" Margin="0,16,0,0"/>
                </StackPanel>

                <StackPanel Margin="44,0,0,34" VerticalAlignment="Bottom" HorizontalAlignment="Left">
                    <TextBlock Text="SECURE   ·   STABLE   ·   TRACEABLE" FontSize="10"
                               Foreground="#5E829B"/>
                    <TextBlock x:Name="VersionText" Text="UX_LabelShop Client" FontSize="10"
                               Foreground="#5E829B" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>

            <!-- ================= 右：登录卡片 ================= -->
            <Grid Grid.Column="1" Background="{StaticResource PanelBase}">
                <!-- 极淡的网格纹理 -->
                <Rectangle Opacity="0.35">
                    <Rectangle.Fill>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,28,28" ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <GeometryDrawing Brush="Transparent">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="0,0,28,28"/>
                                    </GeometryDrawing.Geometry>
                                    <GeometryDrawing.Pen>
                                        <Pen Brush="#102438" Thickness="1"/>
                                    </GeometryDrawing.Pen>
                                </GeometryDrawing>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Border x:Name="LoginCard" Width="336" VerticalAlignment="Center"
                        HorizontalAlignment="Center" CornerRadius="16"
                        Background="#E60C1726" BorderBrush="#20455F" BorderThickness="1"
                        Padding="30">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="8" Opacity="0.45"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="欢迎回来" FontSize="25" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="登录以进入标签打印系统" FontSize="12.5"
                                   Foreground="{StaticResource TextMuted}" Margin="0,7,0,26"/>

                        <TextBlock Text="工号" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,7"/>
                        <Border Style="{StaticResource FieldShell}">
                            <TextBox x:Name="UserNameBox" Style="{StaticResource FieldInput}"
                                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
                        </Border>

                        <TextBlock Text="密码" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,16,0,7"/>
                        <Border Style="{StaticResource FieldShell}">
                            <PasswordBox x:Name="PwdBox" Style="{StaticResource FieldPassword}"
                                         KeyDown="PwdBox_KeyDown"/>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <CheckBox Content="记住工号" Style="{StaticResource DarkCheck}"
                                      IsChecked="{Binding RememberUsername}" VerticalAlignment="Center"/>
                            <CheckBox x:Name="RememberPasswordBox" Content="记住密码"
                                      Style="{StaticResource DarkCheck}" IsChecked="{Binding RememberPassword}"
                                      VerticalAlignment="Center" Margin="16,0,0,0"
                                      ToolTip="密码经 AES 加密后保存在本机 config.json"/>
                        </StackPanel>

                        <Button x:Name="DbSettingButton" Content="数据库 / 本机设置  ›"
                                Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                                Margin="0,14,0,0" Click="DbSettingButton_Click"/>

                        <Button x:Name="LoginButton" Style="{StaticResource LoginButtonStyle}"
                                Margin="0,22,0,0" Click="LoginButton_Click" IsDefault="True">
                            <TextBlock x:Name="LoginButtonText" Text="登 录   →"/>
                        </Button>

                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF8A8A"
                                   Margin="0,14,0,0" TextWrapping="Wrap" MinHeight="34" FontSize="12.5"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="© 2026 UX_LabelShop   ·   Internal Use Only" FontSize="10"
                           Foreground="#4A6B82" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>
            </Grid>

            <!-- 自定义最小化 / 关闭（无边框窗口必备） -->
            <StackPanel Orientation="Horizontal" Grid.ColumnSpan="2"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,10,12,0" Panel.ZIndex="10">
                <Button Content="—" Style="{StaticResource CaptionButton}"
                        ToolTip="最小化" Click="MinimizeButton_Click"/>
                <Button Content="✕" Style="{StaticResource CloseButton}"
                        ToolTip="关闭" Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
