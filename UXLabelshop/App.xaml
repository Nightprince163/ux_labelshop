        <Geometry x:Key="IcoRedo">M14.5,7 H7 V3.5 L1.5,8 L7,12.5 V9 H14.5 Z</Geometry>
        <!-- 撤销/重做：粗曲线箭头（弧 + 实心箭头），对齐参考图的样式 -->
        <Geometry x:Key="IcoUndoCurve">F0 M13.32,9.06 A5.4,5.4 0 0 0 2.68,9.06 L5.05,9.48 A3,3 0 0 1 10.95,9.48 Z M1.2,12.9 L1,7.9 L6,9.6 Z</Geometry>
        <Geometry x:Key="IcoRedoCurve">F0 M2.68,9.06 A5.4,5.4 0 0 1 13.32,9.06 L10.95,9.48 A3,3 0 0 0 5.05,9.48 Z M14.8,12.9 L15,7.9 L10,9.6 Z</Geometry>
        <Geometry x:Key="IcoDelete">F0 M2.8,4 H13.2 L12.2,14.5 H3.8 Z M6,1.5 H10 V3.2 H6 Z M5.2,5.6 H6 V12.8 H5.2 Z M7.6,5.6 H8.4 V12.8 H7.6 Z M10,5.6 H10.8 V12.8 H10 Z</Geometry>
        <!-- 全选：圆角方框 + 破框而出的对勾（框在右上角留出缺口，对勾从缺口穿过） -->
        <Geometry x:Key="IcoSelectAll">F1 M10.6,1 H3.6 A2.6,2.6 0 0 0 1,3.6 V12.4 A2.6,2.6 0 0 0 3.6,15 H12.4 A2.6,2.6 0 0 0 15,12.4 V6.4 H12.9 V11.4 A1.5,1.5 0 0 1 11.4,12.9 H4.6 A1.5,1.5 0 0 1 3.1,11.4 V4.6 A1.5,1.5 0 0 1 4.6,3.1 H10.6 Z M3.79,9.21 L6.39,11.81 L8.01,10.19 L5.41,7.59 Z M8.08,11.74 L15.08,3.34 L13.32,1.86 L6.32,10.26 Z</Geometry>
        <Geometry x:Key="IcoSave">F0 M1,1 H11.5 L15,4.5 V15 H1 Z M3,3 H9.5 V7 H3 Z M3.5,9 H12.5 V14 H3.5 Z</Geometry>
        <Geometry x:Key="IcoPrint">M4,1 H12 V5 H4 Z M1,6 H15 V13 H12.5 V11 H3.5 V13 H1 Z M3.5,11 H12.5 V15 H3.5 Z</Geometry>
        <Geometry x:Key="IcoPublish">M8,1 L14,7 H10.5 V11 H5.5 V7 H2 Z M2,12.5 H14 V15 H2 Z</Geometry>
        <!-- 模板管理 -->
        <Geometry x:Key="IcoNew">M6.5,1 H9.5 V6.5 H15 V9.5 H9.5 V15 H6.5 V9.5 H1 V6.5 H6.5 Z</Geometry>
        <Geometry x:Key="IcoEdit">M2,11.6 L11,2.6 L13.4,5 L4.4,14 L1.6,14.4 Z M9.8,3.8 L12.2,6.2 L10.9,7.5 L8.5,5.1 Z</Geometry>
        <Geometry x:Key="IcoCopy">M1,1.5 H9.5 V10.5 H1 Z M6.5,5.5 H15 V15 H6.5 Z M8,7 H13.5 V13.5 H8 Z</Geometry>
        <Geometry x:Key="IcoDisable">M4,3 H6.6 V13 H4 Z M9.4,3 H12 V13 H9.4 Z</Geometry>
        <Geometry x:Key="IcoRules">M1.5,2.5 H4 V5 H1.5 Z M5.8,2.6 H14.5 V4.9 H5.8 Z M1.5,6.9 H4 V9.4 H1.5 Z M5.8,7 H14.5 V9.3 H5.8 Z M1.5,11.3 H4 V13.8 H1.5 Z M5.8,11.4 H14.5 V13.7 H5.8 Z</Geometry>
        <Geometry x:Key="IcoVar">M1,3.6 H15 V5 H1 Z M1,10.8 H15 V12.2 H1 Z M4.4,1.8 H6.4 V7.2 H4.4 Z M9.6,9 H11.6 V14.4 H9.6 Z</Geometry>
        <!-- 扫码打印 -->
        <Geometry x:Key="IcoAddRow">M1.5,2 H14.5 V6 H1.5 Z M7,7.8 H9 V10.5 H12 V12.5 H9 V15.2 H7 V12.5 H4 V10.5 H7 Z</Geometry>
        <Geometry x:Key="IcoRemoveRow">M1.5,2 H14.5 V6 H1.5 Z M4,10 H12 V12 H4 Z</Geometry>
        <Geometry x:Key="IcoFill">M6.4,1 H9.6 V7.6 H12.4 L8,13 L3.6,7.6 H6.4 Z M1.8,13.6 H14.2 V15.2 H1.8 Z</Geometry>
        <Geometry x:Key="IcoEye">F0 M8,3.8 C4.4,3.8 1.6,5.9 1,8 C1.6,10.1 4.4,12.2 8,12.2 C11.6,12.2 14.4,10.1 15,8 C14.4,5.9 11.6,3.8 8,3.8 Z M8,5.8 A2.2,2.2 0 1,1 8,10.2 A2.2,2.2 0 1,1 8,5.8 Z M8,6.9 A1.1,1.1 0 1,1 8,9.1 A1.1,1.1 0 1,1 8,6.9 Z</Geometry>
        <!-- 打印记录 / 用户管理 -->
        <Geometry x:Key="IcoSearch">M6.4,1.2 A5.2,5.2 0 1,1 6.4,11.6 A5.2,5.2 0 1,1 6.4,1.2 Z M6.4,2.6 A3.8,3.8 0 1,0 6.4,10.2 A3.8,3.8 0 1,0 6.4,2.6 Z M10.6,10.6 L14.6,14.6 L13.2,16 L9.2,12 Z</Geometry>
        <Geometry x:Key="IcoExport">M7,1 H9 V8 L11,6 L12.4,7.4 L8,11.8 L3.6,7.4 L5,6 L7,8 Z M1.5,12.6 H14.5 V15 H1.5 Z</Geometry>
        <Geometry x:Key="IcoRefresh">M2,4 H10 L8,1.5 L9.5,0 L14,4.5 L9.5,9 L8,7.5 L10,5.5 H2 Z M14,12 H6 L8,14.5 L6.5,16 L2,11.5 L6.5,7 L8,8.5 L6,10.5 H14 Z</Geometry>

        <!-- ============ 属性面板：文字样式 / 对齐（图标式开关，选中态带圆角边框） ============ -->
        <Geometry x:Key="IcoBold">F0 M3,2 H8.4 C10.4,2 11.5,3 11.5,4.5 C11.5,5.4 11.1,6.1 10.3,6.5 C11.4,6.9 12.2,7.7 12.2,9.1 C12.2,10.9 10.7,12 8.6,12 H3 Z M5.3,4 V5.9 H8.1 C8.9,5.9 9.3,5.6 9.3,4.95 C9.3,4.3 8.9,4 8.1,4 Z M5.3,7.8 V10 H8.4 C9.4,10 9.9,9.6 9.9,8.9 C9.9,8.2 9.4,7.8 8.4,7.8 Z</Geometry>
        <Geometry x:Key="IcoItalic">M4.5,2.5 H11 V4 H4.5 Z M4,12 H10.5 V13.5 H4 Z M6.9,4 H9.1 L7.1,12 H4.9 Z</Geometry>
        <!-- 自动换行：ab 上行 / c 下行（文字渲染） + 右下蓝色折返箭头 ↵ -->
        <Geometry x:Key="IcoWrapArrow">M6.2,1 H7.6 V6 H2.4 V4.6 H6.2 Z M3.2,3 L1,5.3 L3.2,7.6 Z</Geometry>
        <!-- 水平对齐：长短交替的 4 条横线，分别左 / 居中 / 右对齐（同参考图） -->
        <Geometry x:Key="IcoAlignLeft">M2,2.5 H14 V4 H2 Z M2,5.8 H10 V7.3 H2 Z M2,9.1 H14 V10.6 H2 Z M2,12.4 H10 V13.9 H2 Z</Geometry>
        <Geometry x:Key="IcoAlignCenter">M2,2.5 H14 V4 H2 Z M4,5.8 H12 V7.3 H4 Z M2,9.1 H14 V10.6 H2 Z M4,12.4 H12 V13.9 H4 Z</Geometry>
        <Geometry x:Key="IcoAlignRight">M2,2.5 H14 V4 H2 Z M6,5.8 H14 V7.3 H6 Z M2,9.1 H14 V10.6 H2 Z M6,12.4 H14 V13.9 H6 Z</Geometry>
        <!-- 垂直对齐（参考图样式）：长短交替的 4 条横线，整组分别靠上 / 居中 / 靠下 -->
        <Geometry x:Key="IcoVAlignTop">M2,1.4 H14 V2.9 H2 Z M4,4 H12 V5.5 H4 Z M2,6.6 H14 V8.1 H2 Z M4,9.2 H12 V10.7 H4 Z</Geometry>
        <Geometry x:Key="IcoVAlignMiddle">M2,3 H14 V4.5 H2 Z M4,5.6 H12 V7.1 H4 Z M2,8.2 H14 V9.7 H2 Z M4,10.8 H12 V12.3 H4 Z</Geometry>
        <Geometry x:Key="IcoVAlignBottom">M2,5.2 H14 V6.7 H2 Z M4,7.8 H12 V9.3 H4 Z M2,10.4 H14 V11.9 H2 Z M4,13 H12 V14.5 H4 Z</Geometry>

        <!-- 元素对齐（多选时用）：引导线 + 贴边方块，分布则是等距的三个方块 -->
        <Geometry x:Key="IcoObjAlignLeft">F0 M1.2,2.2 H2.6 V13.8 H1.2 Z M3.8,3.4 H13.4 V6.2 H3.8 Z M3.8,9.4 H9.6 V12.2 H3.8 Z</Geometry>
        <Geometry x:Key="IcoObjAlignRight">F0 M13.4,2.2 H14.8 V13.8 H13.4 Z M2.6,3.4 H12.2 V6.2 H2.6 Z M6.4,9.4 H12.2 V12.2 H6.4 Z</Geometry>
        <Geometry x:Key="IcoObjAlignTop">F0 M2.2,1.2 H13.8 V2.6 H2.2 Z M3.4,3.8 H6.2 V13.4 H3.4 Z M9.4,3.8 H12.2 V9.6 H9.4 Z</Geometry>
        <Geometry x:Key="IcoObjAlignBottom">F0 M2.2,13.4 H13.8 V14.8 H2.2 Z M3.4,2.6 H6.2 V12.2 H3.4 Z M9.4,6.4 H12.2 V12.2 H9.4 Z</Geometry>
        <Geometry x:Key="IcoObjDistributeH">F0 M1.2,2.4 H3.6 V13.6 H1.2 Z M6.8,2.4 H9.2 V13.6 H6.8 Z M12.4,2.4 H14.8 V13.6 H12.4 Z</Geometry>
        <Geometry x:Key="IcoObjDistributeV">F0 M2.4,1.2 H13.6 V3.6 H2.4 Z M2.4,6.8 H13.6 V9.2 H2.4 Z M2.4,12.4 H13.6 V14.8 H2.4 Z</Geometry>

        <!-- ============ 工具栏按钮：图标 + 文字，半透明遮罩做悬停/按下 ============ -->
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border x:Name="Hover" Background="#14000000" CornerRadius="4" Opacity="0"
                                        Margin="-7,-4"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{TemplateBinding Tag}" Width="14" Height="14" Stretch="Uniform"
                                          Fill="{TemplateBinding Foreground}" Margin="0,0,5,0"
                                          VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                                    <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hover" Property="Background" Value="#26000000"/>
                                <Setter TargetName="Hover" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryToolButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Background" Value="#2B579A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="DangerToolButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Foreground" Value="#B91C1C"/>
        </Style>

        <!-- 纯图标工具按钮（撤销/重做、元素对齐）：只有 Tag 里的矢量图标，没有文字 -->
        <Style x:Key="IconToolButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ToolTipService.Placement" Value="Bottom"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <Grid>
                                <Border x:Name="Hover" Background="#14000000" CornerRadius="4" Margin="3"
                                        Opacity="0"/>
                                <Path Data="{TemplateBinding Tag}" Width="15" Height="15" Stretch="Uniform"
                                      Fill="{TemplateBinding Foreground}" HorizontalAlignment="Center"
                                      VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hover" Property="Background" Value="#26000000"/>
                                <Setter TargetName="Hover" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GroupLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Margin" Value="2,0,0,5"/>
        </Style>

        <Style x:Key="ToolSep" TargetType="Rectangle">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Fill" Value="#C3CEDD"/>
            <Setter Property="Margin" Value="8,16,10,0"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>

        <!-- ============ 圆角输入控件：顶部工具栏的 TextBox / ComboBox / DatePicker ============ -->
        <!-- 系统默认模板是方角；这里只重画外框，保留 PART_ContentHost / PART_Popup 等命名部件，
             绑定、输入法、焦点行为都不变。 -->
        <Style x:Key="RoundedTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="CaretBrush" Value="#2B579A"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2B579A"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="Root">
                            <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
                            <ToggleButton x:Name="DropButton" ClickMode="Press" Focusable="False"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                              RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid Background="Transparent">
                                            <Path Data="M0,0 L5,5 L10,0" Stroke="#64748B" StrokeThickness="1.5"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,12,0" Stretch="None"/>
                                        </Grid>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Slide"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border CornerRadius="8" Background="White" BorderBrush="#CBD5E1"
                                        BorderThickness="1" Margin="0,3,0,0"
                                        MinWidth="{Binding ActualWidth,
                                            RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2B579A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedDatePicker" TargetType="DatePicker">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Grid x:Name="Root">
                            <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>
                                <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0"
                                                   Background="Transparent" BorderThickness="0"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   VerticalContentAlignment="Center" Padding="10,0,0,0"
                                                   HorizontalContentAlignment="Left"/>
                                <Button x:Name="PART_Button" Grid.Column="1" Focusable="False"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        Width="26" Height="26" MinWidth="0" MinHeight="0" Padding="0"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid Background="Transparent">
                                                <Path Data="M1,3 H11 V10 H1 Z M1,5 H11 M3.5,1.5 V4 M8.5,1.5 V4"
                                                      Stroke="#64748B" StrokeThickness="1.2"
                                                      Stretch="Uniform" Width="15" Height="15"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                            <Popup x:Name="PART_Popup" Placement="Bottom" StaysOpen="False"
                                   AllowsTransparency="True">
                                <Border CornerRadius="8" Background="White" BorderBrush="#CBD5E1"
                                        BorderThickness="1" Margin="0,3,0,0">
                                    <Calendar x:Name="PART_Calendar" BorderThickness="0" Margin="4"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2B579A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 属性面板图标按钮：图标取自 Tag，选中态圆角边框 + 浅蓝底 ============ -->
        <!-- 开关型（粗体 / 斜体 / 自动换行），各自独立 -->
        <Style x:Key="IconToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <Grid>
                                <Border x:Name="Hover" Background="#14000000" CornerRadius="4" Opacity="0"/>
                                <Path Data="{TemplateBinding Tag}" Width="16" Height="16" Stretch="Uniform"
                                      Fill="{TemplateBinding Foreground}" HorizontalAlignment="Center"
                                      VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EAF0F9"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2B579A"/>
                                <Setter Property="Foreground" Value="#2B579A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 自动换行专用：深色 ab/c 文字块 + 右下角蓝色折返箭头（双色，参考图样式） -->
        <Style x:Key="IconToggleWrap" TargetType="ToggleButton" BasedOn="{StaticResource IconToggle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <Grid>
                                <Border x:Name="Hover" Background="#14000000" CornerRadius="4" Opacity="0"/>
                                <!-- 参考图：ab 在上、c 在下，右下角蓝色 ↵ 表示折到下一行 -->
                                <Grid Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="ab" FontSize="7" FontWeight="Bold" FontFamily="Segoe UI"
                                               Foreground="{TemplateBinding Foreground}"
                                               HorizontalAlignment="Left" VerticalAlignment="Top"
                                               Margin="0,0,0,0"/>
                                    <TextBlock Text="c" FontSize="7" FontWeight="Bold" FontFamily="Segoe UI"
                                               Foreground="{TemplateBinding Foreground}"
                                               HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                               Margin="1,0,0,1"/>
                                    <Path Data="{StaticResource IcoWrapArrow}" Width="9" Height="9"
                                          Stretch="Uniform" Fill="#2B8AE8"
                                          HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                          SnapsToDevicePixels="True"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EAF0F9"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2B579A"/>
                                <Setter Property="Foreground" Value="#2B579A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 单选型（左/中/右、上/中/下对齐），同一 GroupName 互斥 -->
        <Style x:Key="IconRadio" TargetType="RadioButton">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <Grid>
                                <Border x:Name="Hover" Background="#14000000" CornerRadius="4" Opacity="0"/>
                                <Path Data="{TemplateBinding Tag}" Width="16" Height="16" Stretch="Uniform"
                                      Fill="{TemplateBinding Foreground}" HorizontalAlignment="Center"
                                      VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EAF0F9"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2B579A"/>
                                <Setter Property="Foreground" Value="#2B579A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Application.Resources>
</Application>
